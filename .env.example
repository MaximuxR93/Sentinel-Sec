# SentinelFlow Environment Configuration
PORT=3000
VITE_USE_MOCK=true

# MongoDB Atlas Connection URI for Centralized Authentication & Session Management
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sentinelflow?retryWrites=true&w=majority
# Can also be dynamically configured/tested in the UI console
MONGODB_URI=

# Groq API Key for AI-powered AST vulnerability explanation, triage reasoning, and patch synthesis
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=
# Best available Groq model: openai/gpt-oss-120b (120B reasoning model), or qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
